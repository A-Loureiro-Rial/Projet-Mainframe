//JPART1   JOB NOTIFY=&SYSUID,CLASS=A,MSGCLASS=H
//PROCLIB  JCLLIB ORDER=SDJ.FORM.PROCLIB
//*
//         SET SYSUID=API6,
//             NOMPGM=ADDPART
//*
//APPROC   EXEC COMPDB2
//STEPDB2.SYSLIB   DD DSN=&SYSUID..PROJET.DCLGEN,DISP=SHR
//STEPDB2.SYSIN    DD DSN=&SYSUID..PROJET.DB2(&NOMPGM),DISP=SHR
//STEPDB2.DBRMLIB  DD DSN=&SYSUID..SOURCE.DBRMLIB(&NOMPGM),DISP=SHR
//STEPLNK.SYSLMOD  DD DSN=&SYSUID..SOURCE.PGMLIB(&NOMPGM),DISP=SHR
//*
//*--- ETAPE DE BIND --------------------------------------
//*
//BIND     EXEC PGM=IKJEFT01,COND=(4,LT)
//DBRMLIB  DD  DSN=&SYSUID..SOURCE.DBRMLIB,DISP=SHR
//SYSTSPRT DD  SYSOUT=*
//SYSTSIN  DD  *
  DSN SYSTEM (DSN1)
  BIND PLAN      (ADDPART)     -
       QUALIFIER (API6)    -
       ACTION    (REPLACE) -
       MEMBER    (TP3)     -
       VALIDATE  (BIND)    -
       ISOLATION (CS)      -
       ACQUIRE   (USE)     -
       RELEASE   (COMMIT)  -
       EXPLAIN   (NO)
/*
//STEPRUN  EXEC PGM=IKJEFT01,COND=(4,LT)
//STEPLIB  DD DSN=&SYSUID..SOURCE.PGMLIB,DISP=SHR
//SYSOUT   DD  SYSOUT=*
//SYSTSPRT DD  SYSOUT=*
//SYSTSIN  DD  *
//FCONV    DD DSN=&SYSUID..PROJET.CONVERT.KSDS
//FPROD    DD DSN=&SYSUID..PROJET.NEWPRODS.DATA
//FERR     DD DSN=&SYSUID..PROJET.NEWPRODS.ERR
  DSN SYSTEM (DSN1)
  RUN PROGRAM(ADDPART) PLAN (ADDPART)
/*
